# ──────────────────────────────────────────────
# VisionHire Backend — Environment Variables
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/visionhire?retryWrites=true&w=majority

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model name — gemini-1.5-flash is fast and free-tier friendly
GEMINI_MODEL=gemini-1.5-flash

# JWT signing secret — use a long random string in production
JWT_SECRET=change_me_to_a_long_random_string_in_production

# Port the Express server listens on
PORT=5000

# Frontend origin for CORS (Vite default dev port is 5173)
CLIENT_URL=http://localhost:5173
